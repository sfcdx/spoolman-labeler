@@ -0,0 +1,117 @@
+"""Helper functions for interacting with printer database objects."""
+
+import logging
+from datetime import datetime
+
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from spoolman.database import models
+from spoolman.exceptions import ItemNotFoundError
+
+logger = logging.getLogger(__name__)
+
+
+async def _clear_default_flag(db: AsyncSession, *, except_id: int | None = None) -> None:
+    """Take the default flag away from every printer, optionally sparing one.
+
+    Done through the ORM rather than a bulk UPDATE so that any printer already loaded in
+    this session sees the new value: there are only ever a handful of printers, so the
+    extra SELECT costs nothing and the identity map cannot go stale behind our back.
+    """
+    stmt = select(models.Printer).where(models.Printer.is_default.is_(True))
+    if except_id is not None:
+        stmt = stmt.where(models.Printer.id != except_id)
+    rows = await db.execute(stmt)
+    for other in rows.scalars().all():
+        other.is_default = False
+
+
+async def create(
+    *,
+    db: AsyncSession,
+    name: str,
+    host: str,
+    port: int = 631,
+    queue: str = "",
+    use_tls: bool = False,
+    is_default: bool = False,
+    document_format: str = "image/png",
+    comment: str | None = None,
+) -> models.Printer:
+    """Add a new printer to the database."""
+    if is_default:
+        await _clear_default_flag(db)
+
+    printer = models.Printer(
+        registered=datetime.utcnow().replace(microsecond=0),
+        name=name,
+        host=host,
+        port=port,
+        queue=queue,
+        use_tls=use_tls,
+        is_default=is_default,
+        document_format=document_format,
+        comment=comment,
+    )
+    db.add(printer)
+    await db.commit()
+    return printer
+
+
+async def get_by_id(db: AsyncSession, printer_id: int) -> models.Printer:
+    """Get a printer object from the database by the unique ID."""
+    printer = await db.get(models.Printer, printer_id)
+    if printer is None:
+        raise ItemNotFoundError(f"No printer with ID {printer_id} found.")
+    return printer
+
+
+async def find_all(db: AsyncSession) -> list[models.Printer]:
+    """Return every configured printer, oldest first."""
+    rows = await db.execute(
+        select(models.Printer).order_by(models.Printer.id),
+        execution_options={"populate_existing": True},
+    )
+    return list(rows.scalars().all())
+
+
+async def get_default(db: AsyncSession) -> models.Printer:
+    """Return the printer marked as default, or the first one if none is marked."""
+    rows = await db.execute(
+        select(models.Printer).where(models.Printer.is_default.is_(True)).order_by(models.Printer.id),
+    )
+    printer = rows.scalars().first()
+    if printer is None:
+        rows = await db.execute(select(models.Printer).order_by(models.Printer.id))
+        printer = rows.scalars().first()
+    if printer is None:
+        raise ItemNotFoundError("No printer has been configured.")
+    return printer
+
+
+async def update(
+    *,
+    db: AsyncSession,
+    printer_id: int,
+    data: dict,
+) -> models.Printer:
+    """Update the fields of a printer object."""
+    printer = await get_by_id(db, printer_id)
+
+    # Clear the other printers' flag before touching this one, so that nothing this
+    # function has changed can be flushed and then read back in a half-applied state.
+    if data.get("is_default", printer.is_default):
+        await _clear_default_flag(db, except_id=printer_id)
+
+    for k, v in data.items():
+        setattr(printer, k, v)
+    await db.commit()
+    return printer
+
+
+async def delete(db: AsyncSession, printer_id: int) -> None:
+    """Delete a printer object."""
+    printer = await get_by_id(db, printer_id)
+    await db.delete(printer)
+    await db.commit()
diff --git a/tests/test_ipp_live.py b/tests/test_ipp_live.py
new file mode 100644
index 0000000..3ff12ea
--- /dev/null
+++ b/tests/test_ipp_live.py
@@ -0,0 +1,76 @@
+r"""Optional end-to-end checks against a real IPP server.
+
+Skipped unless ``SPOOLMAN_TEST_IPP_HOST`` is set, so the normal test run needs
+no printer and no network. Point it at a CUPS instance to verify the client
+against a real implementation rather than against hand-built payloads:
+
+    SPOOLMAN_TEST_IPP_HOST=localhost \\
+    SPOOLMAN_TEST_IPP_QUEUE=TestLabel \\
+    pytest tests/test_ipp_live.py
+
+The wire format itself is covered without a server in ``test_ipp.py``.
+"""
+
+import os
+import struct
+import zlib
+
+import pytest
+
+from spoolman.printing.ipp import IppClient, build_printer_uri
+
+_HOST = os.environ.get("SPOOLMAN_TEST_IPP_HOST")
+_PORT = int(os.environ.get("SPOOLMAN_TEST_IPP_PORT", "631"))
+_QUEUE = os.environ.get("SPOOLMAN_TEST_IPP_QUEUE", "")
+
+pytestmark = pytest.mark.skipif(not _HOST, reason="SPOOLMAN_TEST_IPP_HOST is not set")
+
+
+def _tiny_png() -> bytes:
+    """Build an 8x8 red PNG, so the test needs no image library."""
+
+    def chunk(kind: bytes, data: bytes) -> bytes:
+        body = kind + data
+        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)
+
+    header = struct.pack(">IIBBBBB", 8, 8, 8, 2, 0, 0, 0)
+    pixels = b"".join(b"\x00" + b"\xff\x00\x00" * 8 for _ in range(8))
+    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", zlib.compress(pixels)) + chunk(b"IEND", b"")
+
+
+@pytest.mark.asyncio
+async def test_queues_can_be_discovered():
+    queues = await IppClient().list_queues(_HOST or "", _PORT)
+
+    assert queues, "The CUPS server reported no queues."
+    assert all(queue.name for queue in queues)
+
+
+@pytest.mark.asyncio
+@pytest.mark.skipif(not _QUEUE, reason="SPOOLMAN_TEST_IPP_QUEUE is not set")
+async def test_printer_reports_a_state():
+    uri = build_printer_uri(_HOST or "", _PORT, _QUEUE)
+
+    state = await IppClient().printer_state(uri)
+
+    # 3 idle, 4 processing, 5 stopped (RFC 8011 section 5.4.11).
+    assert state in {3, 4, 5}
+
+
+@pytest.mark.asyncio
+@pytest.mark.skipif(not _QUEUE, reason="SPOOLMAN_TEST_IPP_QUEUE is not set")
+async def test_a_document_can_be_submitted_and_tracked():
+    client = IppClient()
+    uri = build_printer_uri(_HOST or "", _PORT, _QUEUE)
+
+    job_id = await client.print_document(
+        uri,
+        _tiny_png(),
+        document_format="image/png",
+        job_name="Spoolman IPP live test",
+        copies=1,
+    )
+
+    assert job_id is not None
+    state = await client.job_state(uri, job_id)
+    assert state.state >= 3
diff --git a/tests/test_printer_api.py b/tests/test_printer_api.py
new file mode 100644
index 0000000..9de4100
--- /dev/null
+++ b/tests/test_printer_api.py
@@ -0,0 +1,270 @@
+"""Tests for the printer endpoints and the printer database helpers.
+
+Everything here runs against an in-memory SQLite database, and the IPP client is always
+replaced with a mock: a unit test must never open a socket, least of all to whatever
+happens to answer on port 631 of the machine running the suite.
+"""
+
+import base64
+from collections.abc import AsyncGenerator
+from unittest.mock import AsyncMock, patch
+
+import httpx
+import pytest
+import pytest_asyncio
+from fastapi import FastAPI
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine
+
+from spoolman.api.v1 import printer as printer_api
+from spoolman.database import models
+from spoolman.database import printer as printer_db
+from spoolman.database.database import get_db_session
+from spoolman.exceptions import ItemNotFoundError
+from spoolman.printing.ipp import IppError
+
+
+@pytest_asyncio.fixture
+async def db() -> AsyncGenerator[AsyncSession, None]:
+    """Return a session against a throwaway in-memory database with the full schema."""
+    engine = create_async_engine("sqlite+aiosqlite://")
+    async with engine.begin() as conn:
+        await conn.run_sync(models.Base.metadata.create_all)
+
+    session_maker = async_sessionmaker(engine, expire_on_commit=False)
+    async with session_maker() as session:
+        yield session
+
+    await engine.dispose()
+
+
+@pytest_asyncio.fixture
+async def client(db: AsyncSession) -> AsyncGenerator[httpx.AsyncClient, None]:
+    """Return an HTTP client for an app that serves only the printer router."""
+    app = FastAPI()
+    app.include_router(printer_api.router)
+
+    async def _session() -> AsyncGenerator[AsyncSession, None]:
+        yield db
+
+    app.dependency_overrides[get_db_session] = _session
+
+    transport = httpx.ASGITransport(app=app)
+    async with httpx.AsyncClient(transport=transport, base_url="http://test") as http_client:
+        yield http_client
+
+
+async def _add_printer(db: AsyncSession, name: str, *, is_default: bool = False) -> models.Printer:
+    return await printer_db.create(
+        db=db,
+        name=name,
+        host="192.168.1.50",
+        port=631,
+        queue="labels",
+        is_default=is_default,
+    )
+
+
+@pytest.mark.asyncio
+async def test_print_forwards_the_decoded_document_to_the_printer(client: httpx.AsyncClient, db: AsyncSession):
+    """The endpoint decodes the base64 body and hands the raw bytes to the IPP client."""
+    db_printer = await _add_printer(db, "Label printer")
+    document = b"\x89PNG\r\n\x1a\nlabel-bytes"
+
+    ipp = AsyncMock()
+    ipp.print_document.return_value = 42
+
+    with patch.object(printer_api, "IppClient", return_value=ipp):
+        response = await client.post(
+            f"/printer/{db_printer.id}/print",
+            json={"document_base64": base64.b64encode(document).decode(), "job_name": "Spool 7"},
+        )
+
+    assert response.status_code == 200
+    assert response.json() == {"job_id": 42, "printer_id": db_printer.id}
+
+    args, kwargs = ipp.print_document.call_args
+    assert args[0] == "ipp://192.168.1.50:631/printers/labels"
+    assert args[1] == document
+    assert kwargs["document_format"] == "image/png"
+    assert kwargs["job_name"] == "Spool 7"
+
+
+@pytest.mark.asyncio
+async def test_print_accepts_a_printer_that_reports_no_job_id(client: httpx.AsyncClient, db: AsyncSession):
+    """A printer that accepts the job without naming it is not an error."""
+    db_printer = await _add_printer(db, "Label printer")
+
+    ipp = AsyncMock()
+    ipp.print_document.return_value = None
+
+    with patch.object(printer_api, "IppClient", return_value=ipp):
+        response = await client.post(
+            f"/printer/{db_printer.id}/print",
+            json={"document_base64": base64.b64encode(b"x").decode()},
+        )
+
+    assert response.status_code == 200
+    assert response.json()["job_id"] is None
+
+
+@pytest.mark.asyncio
+async def test_print_rejects_a_document_over_the_size_limit(client: httpx.AsyncClient, db: AsyncSession):
+    """Anything past the cap comes back as 413, and nothing is sent to the printer."""
+    db_printer = await _add_printer(db, "Label printer")
+    oversized = base64.b64encode(b"\x00" * (printer_api.MAX_DOCUMENT_BYTES + 1)).decode()
+
+    ipp = AsyncMock()
+    with patch.object(printer_api, "IppClient", return_value=ipp):
+        response = await client.post(
+            f"/printer/{db_printer.id}/print",
+            json={"document_base64": oversized},
+        )
+
+    assert response.status_code == 413
+    ipp.print_document.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_print_rejects_a_body_that_is_not_base64(client: httpx.AsyncClient, db: AsyncSession):
+    db_printer = await _add_printer(db, "Label printer")
+
+    ipp = AsyncMock()
+    with patch.object(printer_api, "IppClient", return_value=ipp):
+        response = await client.post(
+            f"/printer/{db_printer.id}/print",
+            json={"document_base64": "not base64 !!!"},
+        )
+
+    assert response.status_code == 400
+    ipp.print_document.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_print_reports_a_refusing_printer_as_a_bad_gateway(client: httpx.AsyncClient, db: AsyncSession):
+    """The printer failing is an upstream failure, not a bad request."""
+    db_printer = await _add_printer(db, "Label printer")
+
+    ipp = AsyncMock()
+    ipp.print_document.side_effect = IppError("Could not reach the printer: timed out")
+
+    with patch.object(printer_api, "IppClient", return_value=ipp):
+        response = await client.post(
+            f"/printer/{db_printer.id}/print",
+            json={"document_base64": base64.b64encode(b"x").decode()},
+        )
+
+    assert response.status_code == 502
+    assert "timed out" in response.json()["message"]
+
+
+@pytest.mark.asyncio
+async def test_unreachable_printer_is_a_result_not_an_error(client: httpx.AsyncClient, db: AsyncSession):
+    """A printer that is switched off must not turn into a 5xx."""
+    db_printer = await _add_printer(db, "Label printer")
+
+    ipp = AsyncMock()
+    ipp.printer_state.side_effect = IppError("Could not reach the printer: connection refused")
+
+    with patch.object(printer_api, "IppClient", return_value=ipp):
+        response = await client.post(f"/printer/{db_printer.id}/test")
+
+    assert response.status_code == 200
+    body = response.json()
+    assert body["reachable"] is False
+    assert body["state"] is None
+    assert "connection refused" in body["message"]
+
+
+@pytest.mark.asyncio
+async def test_reachable_printer_reports_its_state(client: httpx.AsyncClient, db: AsyncSession):
+    db_printer = await _add_printer(db, "Label printer")
+
+    ipp = AsyncMock()
+    ipp.printer_state.return_value = 3
+
+    with patch.object(printer_api, "IppClient", return_value=ipp):
+        response = await client.post(f"/printer/{db_printer.id}/test")
+
+    assert response.status_code == 200
+    assert response.json() == {"reachable": True, "state": 3, "message": None}
+
+
+@pytest.mark.asyncio
+async def test_discover_is_not_shadowed_by_the_id_route(client: httpx.AsyncClient):
+    """/printer/discover must reach the discovery handler, not the get-by-id handler."""
+    ipp = AsyncMock()
+    ipp.list_queues.return_value = []
+
+    with patch.object(printer_api, "IppClient", return_value=ipp):
+        response = await client.get("/printer/discover", params={"host": "cups.local"})
+
+    assert response.status_code == 200
+    assert response.json() == []
+    ipp.list_queues.assert_awaited_once_with("cups.local", 631, tls=False)
+
+
+@pytest.mark.asyncio
+async def test_a_second_default_printer_takes_the_flag_from_the_first(db: AsyncSession):
+    first = await _add_printer(db, "First", is_default=True)
+    second = await _add_printer(db, "Second", is_default=True)
+
+    printers = {p.name: p.is_default for p in await printer_db.find_all(db)}
+    assert printers == {"First": False, "Second": True}
+    assert (await printer_db.get_default(db)).id == second.id
+    assert first.is_default is False
+
+
+@pytest.mark.asyncio
+async def test_patching_a_printer_to_default_clears_the_previous_one(client: httpx.AsyncClient, db: AsyncSession):
+    first = await _add_printer(db, "First", is_default=True)
+    second = await _add_printer(db, "Second")
+
+    response = await client.patch(f"/printer/{second.id}", json={"is_default": True})
+    assert response.status_code == 200
+    assert response.json()["is_default"] is True
+
+    printers = {p.id: p.is_default for p in await printer_db.find_all(db)}
+    assert printers == {first.id: False, second.id: True}
+
+
+@pytest.mark.asyncio
+async def test_get_default_falls_back_to_the_first_printer(db: AsyncSession):
+    """With nothing marked as default, the oldest printer is the one labels go to."""
+    first = await _add_printer(db, "First")
+    await _add_printer(db, "Second")
+
+    assert (await printer_db.get_default(db)).id == first.id
+
+
+@pytest.mark.asyncio
+async def test_get_default_without_any_printer_is_a_not_found(db: AsyncSession):
+    with pytest.raises(ItemNotFoundError):
+        await printer_db.get_default(db)
+
+
+@pytest.mark.asyncio
+async def test_unknown_printer_ids_are_not_found(db: AsyncSession):
+    with pytest.raises(ItemNotFoundError):
+        await printer_db.get_by_id(db, 404)
+
+
+@pytest.mark.asyncio
+async def test_printers_can_be_listed_created_and_deleted(client: httpx.AsyncClient):
+    created = await client.post(
+        "/printer",
+        json={"name": "Label printer", "host": "192.168.1.50", "queue": "labels", "document_format": "image/png"},
+    )
+    assert created.status_code == 200
+    printer_id = created.json()["id"]
+    assert created.json()["uri"] == "ipp://192.168.1.50:631/printers/labels"
+
+    listed = await client.get("/printer")
+    assert [item["id"] for item in listed.json()] == [printer_id]
+
+    fetched = await client.get(f"/printer/{printer_id}")
+    assert fetched.status_code == 200
+    assert fetched.json()["name"] == "Label printer"
+
+    deleted = await client.delete(f"/printer/{printer_id}")
+    assert deleted.status_code == 200
+    assert (await client.get("/printer")).json() == []
