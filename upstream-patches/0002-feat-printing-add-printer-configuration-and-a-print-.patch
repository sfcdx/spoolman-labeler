+"""Printer related endpoints.
+
+A printer is an IPP endpoint that Spoolman can hand a rendered label to, so that printing
+does not have to go through the browser's print dialog. The endpoints here manage the
+stored printers and expose the two operations a user interface needs on top of them:
+asking a printer whether it is alive, and sending it a document.
+"""
+
+import base64
+import binascii
+import logging
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, Query
+from fastapi.responses import JSONResponse
+from pydantic import BaseModel, Field
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from spoolman.api.v1.models import Message, SpoolmanDateTime
+from spoolman.database import models as db_models
+from spoolman.database import printer
+from spoolman.database.database import get_db_session
+from spoolman.printing.ipp import IppClient, IppError, build_printer_uri
+
+logger = logging.getLogger(__name__)
+
+router = APIRouter(
+    prefix="/printer",
+    tags=["printer"],
+)
+
+# ruff: noqa: D103
+
+#: A label is a few hundred kilobytes at most. The cap is here so that a malformed or
+#: hostile request cannot make the server hold an arbitrarily large decoded blob in memory.
+MAX_DOCUMENT_BYTES = 20 * 1024 * 1024
+
+#: Base64 grows the payload by 4 bytes per 3 input bytes, so anything longer than this
+#: cannot possibly decode to something within the limit and is refused without decoding.
+_MAX_DOCUMENT_BASE64_CHARS = ((MAX_DOCUMENT_BYTES + 2) // 3) * 4 + 4
+
+_TOO_LARGE_MESSAGE = f"The document exceeds the maximum size of {MAX_DOCUMENT_BYTES} bytes."
+
+
+class Printer(BaseModel):
+    id: int = Field(description="Unique internal ID of this printer.")
+    registered: SpoolmanDateTime = Field(description="When the printer was registered in the database. UTC Timezone.")
+    name: str = Field(max_length=64, description="Printer name.", examples=["Label printer"])
+    host: str = Field(max_length=255, description="Hostname or IP address of the printer.", examples=["192.168.1.50"])
+    port: int = Field(description="TCP port of the printer's IPP service.", examples=[631])
+    queue: str = Field(
+        max_length=128,
+        description="Queue name on the print server. Empty if the printer is addressed directly.",
+        examples=["labels"],
+    )
+    use_tls: bool = Field(description="Whether the printer is addressed over ipps:// instead of ipp://.")
+    is_default: bool = Field(description="Whether labels are sent to this printer by default.")
+    document_format: str = Field(
+        max_length=64,
+        description="MIME type documents are sent to this printer as.",
+        examples=["image/png"],
+    )
+    comment: str | None = Field(
+        None,
+        max_length=1024,
+        description="Free text comment about this printer.",
+        examples=[""],
+    )
+    uri: str = Field(description="The IPP URI this printer is addressed by.", examples=["ipp://192.168.1.50:631/"])
+
+    @staticmethod
+    def from_db(item: db_models.Printer) -> "Printer":
+        """Create a new Pydantic printer object from a database printer object."""
+        return Printer(
+            id=item.id,
+            registered=item.registered,
+            name=item.name,
+            host=item.host,
+            port=item.port,
+            queue=item.queue,
+            use_tls=item.use_tls,
+            is_default=item.is_default,
+            document_format=item.document_format,
+            comment=item.comment,
+            uri=build_printer_uri(item.host, item.port, item.queue, tls=item.use_tls),
+        )
+
+
+class PrinterParameters(BaseModel):
+    name: str = Field(max_length=64, description="Printer name.", examples=["Label printer"])
+    host: str = Field(max_length=255, description="Hostname or IP address of the printer.", examples=["192.168.1.50"])
+    port: int = Field(631, ge=1, le=65535, description="TCP port of the printer's IPP service.", examples=[631])
+    queue: str = Field(
+        "",
+        max_length=128,
+        description="Queue name on the print server. Leave empty for a printer that is addressed directly.",
+        examples=["labels"],
+    )
+    use_tls: bool = Field(
+        default=False,
+        description="Whether to address the printer over ipps:// instead of ipp://.",
+        examples=[False],
+    )
+    is_default: bool = Field(
+        default=False,
+        description="Whether labels should be sent to this printer by default. Only one printer can be the default.",
+        examples=[True],
+    )
+    document_format: str = Field(
+        "image/png",
+        max_length=64,
+        description="MIME type documents are sent to this printer as.",
+        examples=["image/png"],
+    )
+    comment: str | None = Field(
+        None,
+        max_length=1024,
+        description="Free text comment about this printer.",
+        examples=[""],
+    )
+
+
+class PrinterUpdateParameters(BaseModel):
+    name: str | None = Field(None, max_length=64, description="Printer name.", examples=["Label printer"])
+    host: str | None = Field(
+        None,
+        max_length=255,
+        description="Hostname or IP address of the printer.",
+        examples=["192.168.1.50"],
+    )
+    port: int | None = Field(None, ge=1, le=65535, description="TCP port of the IPP service.", examples=[631])
+    queue: str | None = Field(None, max_length=128, description="Queue name on the print server.", examples=["labels"])
+    use_tls: bool | None = Field(
+        None,
+        description="Whether to address the printer over ipps:// instead of ipp://.",
+        examples=[False],
+    )
+    is_default: bool | None = Field(
+        None,
+        description="Whether labels should be sent to this printer by default.",
+        examples=[True],
+    )
+    document_format: str | None = Field(
+        None,
+        max_length=64,
+        description="MIME type documents are sent to this printer as.",
+        examples=["image/png"],
+    )
+    comment: str | None = Field(
+        None,
+        max_length=1024,
+        description="Free text comment about this printer.",
+        examples=[""],
+    )
+
+
+class DiscoveredQueue(BaseModel):
+    name: str = Field(description="Queue name as the server reports it.", examples=["labels"])
+    uri: str = Field(description="IPP URI of the queue.", examples=["ipp://192.168.1.50:631/printers/labels"])
+    info: str | None = Field(None, description="Human readable description.", examples=["Brother QL-800"])
+    location: str | None = Field(None, description="Where the server says the printer stands.", examples=["Workshop"])
+    make_and_model: str | None = Field(None, description="Reported make and model.", examples=["Brother QL-800"])
+    state: int | None = Field(
+        None,
+        description="IPP printer-state: 3 = idle, 4 = processing, 5 = stopped.",
+        examples=[3],
+    )
+
+
+class PrinterTestResult(BaseModel):
+    reachable: bool = Field(description="Whether the printer answered at all.", examples=[True])
+    state: int | None = Field(
+        None,
+        description="IPP printer-state: 3 = idle, 4 = processing, 5 = stopped. Null if the printer did not say.",
+        examples=[3],
+    )
+    message: str | None = Field(
+        None,
+        description="Why the printer could not be reached. Null when it answered.",
+        examples=[None],
+    )
+
+
+class PrintParameters(BaseModel):
+    document_base64: str = Field(
+        description="The document to print, base64 encoded. Must decode to at most 20 MiB.",
+        examples=["iVBORw0KGgoAAAANSUhEUg=="],
+    )
+    job_name: str = Field("Spoolman label", max_length=255, description="Job name shown in the printer's queue.")
+    copies: int = Field(1, ge=1, le=100, description="Number of copies to print.", examples=[1])
+
+
+class PrintResult(BaseModel):
+    job_id: int | None = Field(
+        None,
+        description="Job ID the printer assigned. Null if the printer accepted the job without reporting one.",
+        examples=[42],
+    )
+    printer_id: int = Field(description="ID of the printer the document was sent to.", examples=[1])
+
+
+@router.get(
+    "",
+    name="Find printer",
+    description="Get a list of all configured printers.",
+    response_model_exclude_none=True,
+)
+async def find(
+    db: Annotated[AsyncSession, Depends(get_db_session)],
+) -> list[Printer]:
+    db_items = await printer.find_all(db)
+    return [Printer.from_db(db_item) for db_item in db_items]
+
+
+@router.post(
+    "",
+    name="Add printer",
+    description=(
+        "Add a new printer to the database. If is_default is set, any other printer loses that flag, "
+        "since only one printer can be the default."
+    ),
+    response_model_exclude_none=True,
+)
+async def create(
+    db: Annotated[AsyncSession, Depends(get_db_session)],
+    body: PrinterParameters,
+) -> Printer:
+    db_item = await printer.create(
+        db=db,
+        name=body.name,
+        host=body.host,
+        port=body.port,
+        queue=body.queue,
+        use_tls=body.use_tls,
+        is_default=body.is_default,
+        document_format=body.document_format,
+        comment=body.comment,
+    )
+    return Printer.from_db(db_item)
+
+
+# This must stay above /{printer_id}, otherwise the path parameter swallows it.
+@router.get(
+    "/discover",
+    name="Discover printer queues",
+    description=(
+        "Ask a print server which queues it offers, using the CUPS-Get-Printers operation. "
+        "A server that does not implement it — a standalone network printer, say — answers with an "
+        "empty list rather than an error."
+    ),
+    response_model_exclude_none=True,
+    response_model=list[DiscoveredQueue],
+    responses={502: {"model": Message}},
+)
+async def discover(  # noqa: ANN201
+    *,
+    host: Annotated[str, Query(title="Host", description="Hostname or IP address of the print server.")],
+    port: Annotated[int, Query(title="Port", description="TCP port of the print server's IPP service.")] = 631,
+    tls: Annotated[bool, Query(title="TLS", description="Whether to connect over ipps:// instead of ipp://.")] = False,
+):
+    client = IppClient()
+    try:
+        queues = await client.list_queues(host, port, tls=tls)
+    except IppError as exc:
+        return JSONResponse(status_code=502, content=Message(message=str(exc)).model_dump())
+
+    return [
+        DiscoveredQueue(
+            name=queue.name,
+            uri=queue.uri,
+            info=queue.info,
+            location=queue.location,
+            make_and_model=queue.make_and_model,
+            state=queue.state,
+        )
+        for queue in queues
+    ]
+
+
+@router.get(
+    "/{printer_id}",
+    name="Get printer",
+    description="Get a specific printer.",
+    response_model_exclude_none=True,
+    responses={404: {"model": Message}},
+)
+async def get(
+    db: Annotated[AsyncSession, Depends(get_db_session)],
+    printer_id: int,
+) -> Printer:
+    db_item = await printer.get_by_id(db, printer_id)
+    return Printer.from_db(db_item)
+
+
+@router.patch(
+    "/{printer_id}",
+    name="Update printer",
+    description=(
+        "Update any attribute of a printer. Only fields specified in the request will be affected. "
+        "Setting is_default takes that flag away from every other printer."
+    ),
+    response_model_exclude_none=True,
+    responses={404: {"model": Message}},
+)
+async def update(
+    db: Annotated[AsyncSession, Depends(get_db_session)],
+    printer_id: int,
+    body: PrinterUpdateParameters,
+) -> Printer:
+    patch_data = body.model_dump(exclude_unset=True)
+    db_item = await printer.update(db=db, printer_id=printer_id, data=patch_data)
+    return Printer.from_db(db_item)
+
+
+@router.delete(
+    "/{printer_id}",
+    name="Delete printer",
+    description="Delete a printer.",
+    responses={404: {"model": Message}},
+)
+async def delete(
+    db: Annotated[AsyncSession, Depends(get_db_session)],
+    printer_id: int,
+) -> Message:
+    await printer.delete(db, printer_id)
+    return Message(message="Success!")
+
+
+@router.post(
+    "/{printer_id}/test",
+    name="Test printer",
+    description=(
+        "Ask the printer for its state. A printer that cannot be reached is a valid answer to that "
+        "question, not a server error, so this always responds with 200 and reports the outcome in "
+        "the body."
+    ),
+    responses={404: {"model": Message}},
+)
+async def test(
+    db: Annotated[AsyncSession, Depends(get_db_session)],
+    printer_id: int,
+) -> PrinterTestResult:
+    db_item = await printer.get_by_id(db, printer_id)
+    uri = build_printer_uri(db_item.host, db_item.port, db_item.queue, tls=db_item.use_tls)
+
+    client = IppClient()
+    try:
+        state = await client.printer_state(uri)
+    except IppError as exc:
+        logger.debug("Printer %s at %s did not answer: %s", printer_id, uri, exc)
+        return PrinterTestResult(reachable=False, state=None, message=str(exc))
+
+    return PrinterTestResult(reachable=True, state=state, message=None)
+
+
+@router.post(
+    "/{printer_id}/print",
+    name="Print document",
+    description=(
+        "Send a document to the printer. The document is sent as the MIME type configured on the "
+        "printer, so it must already be in a format the printer understands."
+    ),
+    response_model=PrintResult,
+    responses={
+        400: {"model": Message},
+        404: {"model": Message},
+        413: {"model": Message},
+        502: {"model": Message},
+    },
+)
+async def print_document(  # noqa: ANN201
+    db: Annotated[AsyncSession, Depends(get_db_session)],
+    printer_id: int,
+    body: PrintParameters,
+):
+    if len(body.document_base64) > _MAX_DOCUMENT_BASE64_CHARS:
+        return JSONResponse(
+            status_code=413,
+            content=Message(message=_TOO_LARGE_MESSAGE).model_dump(),
+        )
+
+    try:
+        document = base64.b64decode(body.document_base64, validate=True)
+    except (binascii.Error, ValueError):
+        return JSONResponse(
+            status_code=400,
+            content=Message(message="The document is not valid base64.").model_dump(),
+        )
+
+    if len(document) > MAX_DOCUMENT_BYTES:
+        return JSONResponse(
+            status_code=413,
+            content=Message(message=_TOO_LARGE_MESSAGE).model_dump(),
+        )
+
+    db_item = await printer.get_by_id(db, printer_id)
+    uri = build_printer_uri(db_item.host, db_item.port, db_item.queue, tls=db_item.use_tls)
+
+    client = IppClient()
+    try:
+        job_id = await client.print_document(
+            uri,
+            document,
+            document_format=db_item.document_format,
+            job_name=body.job_name,
+            copies=body.copies,
+        )
+    except IppError as exc:
+        return JSONResponse(
+            status_code=502,
+            content=Message(message=f"The printer did not accept the document: {exc}").model_dump(),
+        )
+
+    return PrintResult(job_id=job_id, printer_id=printer_id)
