+<script lang="ts">
+	import Card from '../Card.svelte';
+	import {
+		discoverPrinters,
+		testPrinter,
+		type DiscoveredPrinter,
+		type Printer,
+		type PrinterParams
+	} from '$lib/api/printers';
+	import { printers } from '$lib/stores/printers.svelte';
+	import * as m from '$lib/paraglide/messages';
+	import Plus from '@lucide/svelte/icons/plus';
+
+	// Manages the (optional) network label printers. Everything here is opt-in:
+	// with no printer configured the label designer keeps printing through the
+	// browser dialog exactly as before.
+
+	const DEFAULT_PORT = 631;
+	// What the server may be asked to send. PNG first: that is what the label
+	// rasterizer produces, and what the print action actually uploads.
+	const DOCUMENT_FORMATS = ['image/png', 'image/jpeg', 'application/pdf', 'application/octet-stream'];
+
+	$effect(() => {
+		printers.ensure();
+	});
+
+	// Editor ------------------------------------------------------------------
+	let editing = $state(false);
+	let editId = $state<number | null>(null);
+	let saving = $state(false);
+	let error = $state('');
+
+	let name = $state('');
+	let host = $state('');
+	let port = $state(DEFAULT_PORT);
+	let queue = $state('');
+	let useTls = $state(false);
+	let isDefault = $state(false);
+	let documentFormat = $state(DOCUMENT_FORMATS[0]);
+	let comment = $state('');
+
+	function startAdd() {
+		editing = true;
+		editId = null;
+		error = '';
+		name = '';
+		host = '';
+		port = DEFAULT_PORT;
+		queue = '';
+		useTls = false;
+		// A first printer is the default one — there is nothing else it could be.
+		isDefault = printers.printers.length === 0;
+		documentFormat = DOCUMENT_FORMATS[0];
+		comment = '';
+	}
+
+	function startEdit(p: Printer) {
+		editing = true;
+		editId = p.id;
+		error = '';
+		name = p.name;
+		host = p.host;
+		port = p.port;
+		queue = p.queue;
+		useTls = p.use_tls;
+		isDefault = p.is_default;
+		documentFormat = p.document_format || DOCUMENT_FORMATS[0];
+		comment = p.comment ?? '';
+	}
+
+	function cancel() {
+		editing = false;
+		error = '';
+	}
+
+	function describe(e: unknown, fallback: string): string {
+		return e instanceof Error && e.message ? e.message : fallback;
+	}
+
+	async function save() {
+		error = '';
+		if (!name.trim()) {
+			error = m['settings.printers.errors.nameRequired']();
+			return;
+		}
+		if (!host.trim()) {
+			error = m['settings.printers.errors.hostRequired']();
+			return;
+		}
+		if (!queue.trim()) {
+			error = m['settings.printers.errors.queueRequired']();
+			return;
+		}
+
+		const params: PrinterParams = {
+			name: name.trim(),
+			host: host.trim(),
+			port: Math.max(1, Math.round(port) || DEFAULT_PORT),
+			queue: queue.trim(),
+			use_tls: useTls,
+			is_default: isDefault,
+			document_format: documentFormat,
+			comment: comment.trim() ? comment.trim() : null
+		};
+
+		saving = true;
+		try {
+			if (editId === null) await printers.create(params);
+			else await printers.update(editId, params);
+			editing = false;
+		} catch (e) {
+			error = describe(e, m['settings.printers.errors.saveFailed']());
+		} finally {
+			saving = false;
+		}
+	}
+
+	async function del(p: Printer) {
+		if (!confirm(m['settings.printers.deleteConfirm']({ name: p.name }))) return;
