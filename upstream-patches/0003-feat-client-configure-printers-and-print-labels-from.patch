+	// --- Server-side printing (optional) -----------------------------------------
+	// Only ever visible once the user has registered a printer under Settings; with
+	// none configured this whole path stays dormant and the browser print dialog
+	// remains the only way to print.
+	let serverPrinting = $state(false);
+	let chosenPrinterId = $state<number | null>(null);
+	$effect(() => {
+		printers.ensure();
+	});
+	// The picker is a preference, not a target: an unset (or since-removed) choice
+	// falls back to the configured default printer.
+	const targetPrinter = $derived(
+		printers.printers.find((p) => p.id === chosenPrinterId) ?? printers.defaultPrinter
+	);
+
+	async function doServerPrint() {
+		const printer = targetPrinter;
+		if (bindings.length === 0 || !printer) return;
+		serverPrinting = true;
+		try {
+			const res = await printLabelsToServer({
+				design,
+				bindings,
+				layout,
+				baseUrl: settings.baseUrl,
+				printerId: printer.id
+			});
+			if (res.failed === 0) {
+				toasts.success(m['printing.server.sent']({ count: res.sent, printer: printer.name }));
+			} else if (res.sent === 0) {
+				toasts.error(m['printing.server.failed']({ printer: printer.name, error: res.error ?? '' }));
+			} else {
+				toasts.error(
+					m['printing.server.partial']({
+						sent: res.sent,
+						total: res.total,
+						printer: printer.name,
+						failed: res.failed,
+						error: res.error ?? ''
+					})
+				);
+			}
+		} catch (e) {
+			console.error('Server print failed', e);
+			toasts.error(
+				m['printing.server.failed']({
+					printer: printer.name,
+					error: e instanceof Error ? e.message : String(e)
+				})
+			);
+		} finally {
+			serverPrinting = false;
+		}
+	}
