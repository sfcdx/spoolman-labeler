index 0000000..4ad5ea8
--- /dev/null
+++ b/client_v2/src/lib/api/printers.test.ts
@@ -0,0 +1,38 @@
+import { describe, it, expect, vi } from 'vitest';
+
+// Only the pure helper is under test here; stub the base URL so importing the
+// module doesn't drag SvelteKit's runtime path resolution into a node test.
+vi.mock('./config', () => ({ API_BASE: 'http://spoolman.test/api/v1' }));
+
+import { dataUrlToBase64 } from './printers';
+
+// The print endpoint takes the raw base64 payload, not the data URL the canvas
+// hands us. Getting this wrong sends `data:image/png;base64,…` to the printer,
+// which the server can only reject — so it is worth pinning down.
+
+describe('dataUrlToBase64', () => {
+	it('drops the data URL prefix', () => {
+		expect(dataUrlToBase64('data:image/png;base64,iVBORw0KGgo=')).toBe('iVBORw0KGgo=');
+	});
+
+	it('handles other media types and parameters', () => {
+		expect(dataUrlToBase64('data:application/pdf;base64,JVBERi0=')).toBe('JVBERi0=');
+		expect(dataUrlToBase64('data:image/png;charset=utf-8;base64,AAAA')).toBe('AAAA');
+	});
+
+	it('keeps commas that belong to the payload', () => {
+		// Base64 never contains a comma, but slicing at the *first* one is what makes
+		// that true in practice — assert the split point rather than trusting it.
+		expect(dataUrlToBase64('data:image/png;base64,AA,BB')).toBe('AA,BB');
+	});
+
+	it('yields an empty payload for an empty image', () => {
+		expect(dataUrlToBase64('data:image/png;base64,')).toBe('');
+	});
+
+	it('rejects anything that is not base64-encoded', () => {
+		expect(() => dataUrlToBase64('data:image/svg+xml,<svg/>')).toThrow();
+		expect(() => dataUrlToBase64('https://example.com/label.png')).toThrow();
+		expect(() => dataUrlToBase64('')).toThrow();
+	});
+});
diff --git a/client_v2/src/lib/api/printers.ts b/client_v2/src/lib/api/printers.ts
new file mode 100644
index 0000000..2c7db60
--- /dev/null
+++ b/client_v2/src/lib/api/printers.ts
@@ -0,0 +1,115 @@
+import { getJson, postJson, patchJson, deleteResource } from './http';
+
+// Network label printers (/api/v1/printer). Purely additive: with no printer
+// registered the client behaves exactly as before — the browser print dialog
+// stays the only way to print.
+
+/** A printer registered on the server, addressed over IPP (a CUPS queue). */
+export interface Printer {
+	id: number;
+	registered: string;
+	name: string;
+	host: string;
+	port: number;
+	queue: string;
+	use_tls: boolean;
+	is_default: boolean;
+	document_format: string;
+	comment: string | null;
+}
+
+/** Editable printer fields (POST body; PATCH takes any subset). */
+export interface PrinterParams {
+	name: string;
+	host: string;
+	port: number;
+	queue: string;
+	use_tls: boolean;
+	is_default: boolean;
+	/** IPP document-format MIME type, e.g. `image/png`. */
+	document_format: string;
+	comment?: string | null;
+}
+
+/** A print queue found on a CUPS/IPP server by `discoverPrinters`. */
+export interface DiscoveredPrinter {
+	name: string;
+	uri: string;
+	info: string | null;
+	location: string | null;
+	make_and_model: string | null;
+	state: number | null;
+}
+
+/**
+ * Outcome of a connection test. The endpoint answers 200 even for a printer it
+ * could not reach — `reachable` carries that verdict, `message` the detail.
+ */
+export interface PrinterTestResult {
+	reachable: boolean;
+	state: number | null;
+	message: string | null;
+}
+
+export interface PrintJobResult {
+	job_id: number | null;
+	printer_id: number;
+}
+
+export function listPrinters(signal?: AbortSignal): Promise<Printer[]> {
+	return getJson<Printer[]>('/printer', {}, signal);
+}
+
+export function getPrinter(id: number, signal?: AbortSignal): Promise<Printer> {
+	return getJson<Printer>(`/printer/${id}`, {}, signal);
+}
+
+export function createPrinter(params: PrinterParams): Promise<Printer> {
+	return postJson<Printer>('/printer', params);
+}
+
+export function updatePrinter(id: number, params: Partial<PrinterParams>): Promise<Printer> {
+	return patchJson<Printer>(`/printer/${id}`, params);
+}
+
+export function deletePrinter(id: number): Promise<void> {
+	return deleteResource(`/printer/${id}`);
+}
+
+/** List the queues an IPP/CUPS server offers, so they can be picked instead of typed. */
+export function discoverPrinters(
+	host: string,
+	port: number,
+	tls: boolean,
+	signal?: AbortSignal
+): Promise<DiscoveredPrinter[]> {
+	return getJson<DiscoveredPrinter[]>('/printer/discover', { host, port, tls: String(tls) }, signal);
+}
+
+export function testPrinter(id: number): Promise<PrinterTestResult> {
+	return postJson<PrinterTestResult>(`/printer/${id}/test`, {});
+}
+
+/** Send one already-encoded document to a printer. */
+export function printDocument(
+	id: number,
+	document_base64: string,
+	options: { job_name?: string; copies?: number } = {}
+): Promise<PrintJobResult> {
+	return postJson<PrintJobResult>(`/printer/${id}/print`, { document_base64, ...options });
+}
+
+/**
+ * Strip the `data:<mime>;base64,` prefix off a data URL, leaving the payload the
+ * print endpoint wants. Rasterized labels always arrive base64-encoded (that is
+ * what `HTMLCanvasElement.toDataURL` produces), so anything else is a bug worth
+ * surfacing rather than a string to pass along and have the server reject.
+ */
+export function dataUrlToBase64(dataUrl: string): string {
+	const comma = dataUrl.indexOf(',');
+	const header = comma === -1 ? '' : dataUrl.slice(0, comma);
+	if (!/^data:[^,]*;base64$/i.test(header)) {
+		throw new Error('Expected a base64 data URL');
+	}
+	return dataUrl.slice(comma + 1);
+}
