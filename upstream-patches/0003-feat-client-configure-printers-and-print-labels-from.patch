+import { dataUrlToBase64, printDocument } from '$lib/api/printers';
+import { getLogoImage } from './logo';
+import { renderLabelDataUrl, resolveDpi } from './print';
+import type { LabelBinding } from './template';
+import type { LabelDesign, PrintLayout } from './types';
+
+// Sends labels to a server-side printer instead of the browser's print dialog.
+//
+// The rasterization is the same one the browser print uses (renderLabelDataUrl),
+// so a label looks identical either way; only the delivery differs. Nothing in
+// here runs unless the user has configured a printer and pressed the extra
+// button — the browser path is untouched.
+
+export interface ServerPrintJob {
+	design: LabelDesign;
+	bindings: LabelBinding[];
+	layout: PrintLayout;
+	baseUrl: string;
+	printerId: number;
+}
+
+export interface ServerPrintResult {
+	/** Labels attempted (spools/filaments, not copies). */
+	total: number;
+	sent: number;
+	failed: number;
+	/** Message of the first failure, for a one-line summary. */
+	error?: string;
+}
+
+/**
+ * Rasterize each selected label and post it to the printer, one request per
+ * label. Sequential on purpose: a print queue is a single physical device, and
+ * pipelining a batch at it only makes the failure modes harder to explain.
+ *
+ * A label that fails is counted and the run continues — one unprintable label
+ * shouldn't cost the user the rest of the batch.
+ */
+export async function printLabelsToServer({
+	design,
+	bindings,
+	layout,
+	baseUrl,
+	printerId
+}: ServerPrintJob): Promise<ServerPrintResult> {
+	const result: ServerPrintResult = { total: bindings.length, sent: 0, failed: 0 };
+	if (bindings.length === 0) return result;
+
+	const logoImage = await getLogoImage().catch(() => null);
+	const dpi = resolveDpi(layout);
+	const copies = Math.max(1, layout.copies);
+
+	for (const binding of bindings) {
+		const subjectId = binding.spool?.id ?? binding.filament?.id;
+		try {
+			const dataUrl = renderLabelDataUrl(design, binding, baseUrl, logoImage, dpi);
+			await printDocument(printerId, dataUrlToBase64(dataUrl), {
+				job_name: `spoolman-label-${subjectId ?? 'unknown'}`,
+				copies
+			});
+			result.sent++;
+		} catch (e) {
+			console.error('Server print failed for label', subjectId, e);
+			result.failed++;
+			result.error ??= e instanceof Error ? e.message : String(e);
+		}
+	}
+	return result;
+}
