+import {
+	createPrinter,
+	deletePrinter,
+	listPrinters,
+	updatePrinter,
+	type Printer,
+	type PrinterParams
+} from '$lib/api/printers';
+
+// Reactive, server-backed list of label printers. Mirrors labelDesigns.svelte.ts:
+// a singleton runes class, loaded once on demand, mutations written straight
+// through to the API.
+//
+// Everything here is opt-in — an installation with no printers keeps an empty
+// list, and the UI that consumes it stays hidden.
+
+/**
+ * The printer a print job should go to when the user hasn't picked one: the one
+ * flagged as default, else the first configured, else nothing at all.
+ */
+export function pickDefaultPrinter(list: readonly Printer[]): Printer | null {
+	return list.find((p) => p.is_default) ?? list[0] ?? null;
+}
+
+class Printers {
+	printers = $state<Printer[]>([]);
+	loaded = $state(false);
+	/** Where a print goes unless the user chooses otherwise; null when unconfigured. */
+	defaultPrinter = $derived(pickDefaultPrinter(this.printers));
+
+	#loading = false;
+
+	/** Load once (idempotent), for views that just need the list to be there. */
+	ensure(): void {
+		if (!this.loaded && !this.#loading) void this.load();
+	}
+
+	/**
+	 * Fetch the list. A failure here must not take the page down with it — a
+	 * server without the printer endpoints (or one that is simply unhappy) should
+	 * leave the client exactly as it was before server printing existed.
+	 */
+	async load(force = false): Promise<void> {
+		if (this.loaded && !force) return;
+		this.#loading = true;
+		try {
+			this.printers = await listPrinters();
+		} catch (e) {
+			console.error('Failed to load printers', e);
+		} finally {
+			this.#loading = false;
+			this.loaded = true;
+		}
+	}
+
+	/**
+	 * Re-read the list after a mutation. The default flag is exclusive and enforced
+	 * server-side, so a write can change rows we didn't touch; refetching keeps the
+	 * view honest instead of guessing at those side effects.
+	 */
+	async refresh(): Promise<void> {
+		await this.load(true);
+	}
+
+	async create(params: PrinterParams): Promise<Printer> {
+		const printer = await createPrinter(params);
+		await this.refresh();
+		return printer;
+	}
+
+	async update(id: number, params: Partial<PrinterParams>): Promise<Printer> {
+		const printer = await updatePrinter(id, params);
+		await this.refresh();
+		return printer;
+	}
+
+	async remove(id: number): Promise<void> {
+		await deletePrinter(id);
+		await this.refresh();
+	}
+
+	/** Make `id` the printer new jobs go to by default. */
+	async makeDefault(id: number): Promise<void> {
+		await this.update(id, { is_default: true });
+	}
+}
+
+export const printers = new Printers();
