+import { describe, it, expect, vi } from 'vitest';
+
+// The store talks to the API on construction of nothing, but importing it pulls
+// the client in; stub it so this stays a pure test of the selection rule.
+vi.mock('$lib/api/printers', () => ({
+	listPrinters: vi.fn(),
+	createPrinter: vi.fn(),
+	updatePrinter: vi.fn(),
+	deletePrinter: vi.fn()
+}));
+
+import { pickDefaultPrinter, printers } from './printers.svelte';
+import type { Printer } from '$lib/api/printers';
+
+function printer(id: number, is_default = false): Printer {
+	return {
+		id,
+		registered: '2024-01-01T00:00:00Z',
+		name: `Printer ${id}`,
+		host: 'cups.local',
+		port: 631,
+		queue: `q${id}`,
+		use_tls: false,
+		is_default,
+		document_format: 'image/png',
+		comment: null
+	};
+}
+
+// Which printer a job goes to when the user didn't pick one. The fallback chain
+// matters: a fresh install has no default flag set anywhere, and a user with one
+// printer should still be able to print without first marking it.
+describe('pickDefaultPrinter', () => {
+	it('prefers the printer flagged as default', () => {
+		const list = [printer(1), printer(2, true), printer(3)];
+		expect(pickDefaultPrinter(list)?.id).toBe(2);
+	});
+
+	it('falls back to the first printer when nothing is flagged', () => {
+		expect(pickDefaultPrinter([printer(7), printer(8)])?.id).toBe(7);
+	});
+
+	it('returns null when no printer is configured', () => {
+		expect(pickDefaultPrinter([])).toBeNull();
+	});
+
+	it('takes the first flagged printer if several claim to be default', () => {
+		expect(pickDefaultPrinter([printer(1), printer(2, true), printer(3, true)])?.id).toBe(2);
+	});
+});
+
+describe('printers store', () => {
+	it('tracks the default as the list changes', () => {
+		printers.printers = [printer(1), printer(2, true)];
+		expect(printers.defaultPrinter?.id).toBe(2);
+		printers.printers = [printer(3)];
+		expect(printers.defaultPrinter?.id).toBe(3);
+		printers.printers = [];
+		expect(printers.defaultPrinter).toBeNull();
+	});
+});
