 	let canSubmit = $derived((creating || !!chosen) && Object.keys(errors).length === 0);
+
+	// --- optional: print the labels for the spools just added --------------------
+	// Purely additive. Everything below is dormant unless the user has both a
+	// configured printer and a spool label design; with either missing the extra
+	// button never renders and this dialog behaves exactly as it did before.
+
+	// Loaded lazily on open: an installation without printers shouldn't pay for
+	// these requests on every page load just because the modal lives in the layout.
+	$effect(() => {
+		if (!open) return;
+		printers.ensure();
+		void labelDesigns.load();
+	});
+
+	// Spools get spool labels; a filament design can't be bound to a spool here.
+	let printDesign = $derived(labelDesigns.designs.find((d) => labelKind(d) === 'spool'));
+	let canPrint = $derived(!!printDesign && printers.printers.length > 0 && !!printers.defaultPrinter);
+	// Distinguishes the two busy buttons while a submit is in flight.
+	let printSubmitting = $state(false);
+
+	function bindingFor(s: Spool): LabelBinding {
+		const filament = inventory.filamentById(s.filamentId);
+		return { spool: s, filament, vendor: filament ? inventory.vendorById(filament.vendorId) : undefined };
+	}
+
+	/**
+	 * Send one label per freshly created spool to the default printer. Reports the
+	 * outcome and swallows every failure: the spools are already saved, so a dead
+	 * printer must not look like a failed add (and must never undo one).
+	 */
+	async function printLabelsFor(spools: Spool[]) {
+		const printer = printers.defaultPrinter;
+		const design = printDesign;
+		if (!printer || !design || spools.length === 0) return;
+		try {
+			const res = await printLabelsToServer({
+				design,
+				bindings: spools.map(bindingFor),
+				layout: DEFAULT_LAYOUT,
+				baseUrl: settings.baseUrl,
+				printerId: printer.id
+			});
+			if (res.failed === 0) {
+				toasts.success(m['add.printSent']({ count: res.sent, printer: printer.name }));
+			} else if (res.sent === 0) {
+				toasts.error(
+					m['add.printFailed']({ count: spools.length, printer: printer.name, error: res.error ?? '' })
+				);
+			} else {
+				toasts.error(
+					m['add.printPartial']({
+						count: spools.length,
+						sent: res.sent,
+						total: res.total,
+						printer: printer.name,
+						error: res.error ?? ''
+					})
+				);
+			}
+		} catch (e) {
+			console.error('Failed to print labels for the new spools', e);
+			toasts.error(
+				m['add.printFailed']({
+					count: spools.length,
+					printer: printer.name,
+					error: e instanceof Error ? e.message : String(e)
+				})
+			);
+		}
+	}
+
+	async function submitAndPrint() {
+		printSubmitting = true;
+		try {
+			await submit(false, true);
+		} finally {
+			printSubmitting = false;
+		}
+	}
 </script>
 
